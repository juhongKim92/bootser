# Cloudflare 정적 자산의 응답 머리. 이 파일 자체는 배포되지 않고 규칙으로만 쓰인다.
#
# 글꼴 파일 이름에는 내용 해시가 박혀 있다(tools/gen-fonts.mjs) — 내용이 달라지면
# 이름이 달라지므로 immutable 이 참말이다. fonts.css 는 이름이 고정이라 안 된다.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/fonts.css
  Cache-Control: public, max-age=86400

# 공유 카드도 국가 목록이 바뀔 때만 달라진다. 다만 이름이 고정(card/{cc}.png)이라
# immutable 은 아니다 — 하루 두고 CDN 이 되받게 한다.
/card/*
  Cache-Control: public, max-age=86400

# 국기도 같다. 이름이 flags/{cc}.svg 로 고정이고, 국기 도안이 실제로 바뀌는 일이
# 있다(2011 리비아 · 2021 아프가니스탄). 목록 페이지는 lazy 로 걸려 있어서 첫
# 방문에 다 받지 않고, 그 뒤로는 이 캐시에서 온다.
/flags/*
  Cache-Control: public, max-age=86400

# 하늘 아이콘(절기·삭·보름·유성우)은 우리가 그린 것이라 도안이 남의 사정으로 바뀌지
# 않는다. 그래도 이름이 고정(sky-icons/{이름}.svg)이라 immutable 은 못 쓴다 —
# 원화를 손보면 같은 주소에 다른 그림이 온다. 국기와 같은 하루로 둔다.
/sky-icons/*
  Cache-Control: public, max-age=86400
